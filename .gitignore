# =========================
# Global ignores
# =========================
.DS_Store
Thumbs.db
*.log
*.tmp
*.swp
*.swo

# =========================
# Python / FastAPI backend
# =========================
# Bytecode / cache
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
env/
venv/
ENV/

# Pytest / coverage
.pytest_cache/
.coverage
coverage/
htmlcov/

# Build / packaging
build/
dist/
*.egg-info/

# IDE
.vscode/
.idea/

# Local environment / secrets
.env
.env.*          # like .env.dev, .env.prod
*.sqlite3
*.db

# =========================
# Node / React frontend
# =========================
# Dependencies
frontend/node_modules/
frontend/.pnp/
frontend/.pnp.js
*.tsbuildinfo

# Build output
frontend/build/
frontend/dist/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# IDE/editor
frontend/.vscode/
frontend/.idea/

# Local env
frontend/.env
frontend/.env.*
